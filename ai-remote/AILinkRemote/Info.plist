<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AILinkCloudURL</key>
	<string>$(AILINK_CLOUD_URL)</string>
	<key>AILinkCloudKey</key>
	<string>$(AILINK_CLOUD_KEY)</string>
	<key>CFBundleDisplayName</key>
	<string>AI Remote</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pauldenchat.AILinkRemote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ailink</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your local AI Link LAN server to monitor and control terminal sessions.</string>
</dict>
</plist>
